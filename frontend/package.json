{
  "name": "@my-app/frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:free-port": "node scripts/dev.mjs --free-port-only",
    "clean": "node scripts/dev.mjs --clean-all",
    "build": "next build",
    "build:clean": "node scripts/dev.mjs --clean-all && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "self-check": "node scripts/self-check.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@my-app/backend": "workspace:*",
    "@my-app/shared": "workspace:*",
    "@upstash/redis": "^1.38.4",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.46.0",
    "marked": "^18.0.13",
    "marked-highlight": "^2.2.4",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "^2.6.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}
